# .env for go-base-system-v2 (local Docker Compose development)
# 这个文件用于为 docker-compose.yml 提供环境变量的默认值。
# 注意：此文件应包含在 .gitignore 中，以避免将敏感信息或本地特定配置提交到版本控制。

# 应用 HTTP 服务端口 (映射到主机)
APP_HTTP_PORT=8080

# 数据库主机端口 (映射到主机的端口，以避免与本地 MySQL 冲突)
DB_HOST_PORT=3307

# MySQL 数据库配置
DB_ROOT_PASSWORD=myrootsecret123!#RootP@sswOrd
DB_NAME=go_base_system_v2_compose_dev
DB_USER=appcomposeuser
DB_PASSWORD=appcomposepassword123!#UserP@ss

# JWT 配置
# 强烈建议使用更长、更随机的密钥，并考虑从更安全的地方加载 (例如 Docker Secrets 或 HashiCorp Vault)。
JWT_SECRET_KEY=thisIsAStrongerAndLongerSecretKeyForComposeEnvironment!PleaseChangeMe

# Gin 运行模式 (debug, release, test)
GIN_RUN_MODE=debug

# 日志级别 (debug, info, warn, error, dpanic, panic, fatal)
LOGGER_LEVEL=debug

# Casbin 策略自动加载 (可选，默认为 false, 1 分钟间隔)
# APP_CASBIN_AUTO_LOAD_POLICY=true
# APP_CASBIN_AUTO_LOAD_POLICY_INTERVAL_MINUTES=1
