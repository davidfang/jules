# admin-ui/.env.example
# 这个文件是 admin-ui 前端应用的环境变量示例文件。
# 在本地开发时，可以复制此文件为 .env.development 或 .env.local，并根据需要修改其中的值。
# Vite 会自动加载以 VITE_ 开头的环境变量，并将其暴露给客户端代码。
# 注意：不要在此文件中存储任何生产环境的敏感信息。

# 后端API服务的基础URL (用于开发环境)
# 在本地开发时，前端通常会请求运行在 localhost 上的后端服务。
# 确保此 URL 与后端服务的实际监听地址和 API 基础路径匹配。
VITE_API_BASE_URL=http://localhost:8080/api/v1

# (可选) 应用标题或其他前端需要的环境变量
# 例如，可以在应用标题栏或页面中显示此标题。
# VITE_APP_TITLE="我的管理后台 - 开发版"

# (可选) 其他前端特定配置
# 例如，是否启用某些调试功能、第三方服务的 API Key (仅限安全的、公开的 Key) 等。
# VITE_FEATURE_FLAG_NEW_DESIGN=true
# VITE_MAP_API_KEY="YOUR_PUBLIC_MAP_API_KEY_IF_NEEDED"
